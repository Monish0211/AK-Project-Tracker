generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ROLE
// =============================================================================
// A fixed set of job-function roles (Administrator, PMO Manager, Project
// Manager, Project Coordinator, Department Head, Engineer, Finance, Accounts,
// Management Viewer, Read Only — seeded in prisma/seed.ts). Role decides
// broad login/visibility behavior (e.g. "sees every project" vs "sees only
// assigned projects" — enforced later by the Projects module); it is
// deliberately NOT where individual module/region/approval access lives —
// those are per-user grants stored in their own tables below, exactly so a
// Manager can hand-tune one specific PMO_USER's access without that
// affecting every other holder of the same role.
model PortalRole {
  id          String  @id @default(dbgenerated("gen_random_uuid()"))
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  users PortalUser[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// PORTAL USER
// =============================================================================
// A user who can actually log into the PMO Portal — deliberately separate
// from any future "Employee" record (Engineers/Draftsmen/Consultants never
// log in; they exist only as Employee data for Timesheets/Manpower/Reports).
// Login is by email + password ONLY — employeeCode is a display-only
// business identifier, never used for authentication.
model PortalUser {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  // Identity — login is ALWAYS by email, never employeeCode.
  employeeCode String? @unique
  fullName     String
  email        String  @unique
  passwordHash String

  // HR-ish descriptive fields. Plain strings for now (not a relation into a
  // future Departments module) — safe to upgrade to a proper FK once that
  // module exists, since these are just display/filter attributes, not
  // anything Auth's own logic branches on.
  phoneNumber  String?
  department   String?
  designation  String?
  employeeType String?

  // A portal user's own manager — also a PortalUser (self-relation). Kept
  // optional and self-contained; not tied to the future Employee entity.
  reportingManagerId String?
  reportingManager   PortalUser?  @relation("PortalUserReportingManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports      PortalUser[] @relation("PortalUserReportingManager")

  roleId String
  role   PortalRole @relation(fields: [roleId], references: [id])

  // Account security — see shared/middleware/authenticate.ts and
  // auth.service.ts for how these gate login.
  isActive            Boolean   @default(true)
  forcePasswordChange Boolean   @default(false)
  accountLocked       Boolean   @default(false)
  // Consecutive bad-password count since the last successful login or
  // password set — auth.service.ts locks the account once this reaches
  // env.MAX_FAILED_LOGIN_ATTEMPTS, and resets it to 0 on success.
  failedLoginAttempts Int       @default(0)
  passwordResetAt     DateTime?
  passwordExpiresAt   DateTime?
  lastLogin           DateTime?

  // Per-user, data-driven access grants — see the three sections below.
  // Deliberately NEVER hardcoded in application code; a Manager grants/
  // revokes these per user via rows in these join tables.
  moduleAccess        UserModuleAccess[]
  regionAccess        UserRegionAccess[]
  approvalPermissions UserApprovalPermission[]

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  authAuditLogs       AuthAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// REFRESH TOKENS
// =============================================================================
// Opaque, high-entropy bearer tokens (NOT JWTs) so an individual token can be
// revoked server-side — a signed JWT refresh token can't be un-issued
// without a separate blacklist, which is just this table by another name.
// Only the sha256 hash is ever stored; the plaintext is returned to the
// client exactly once, at issuance/rotation.
model RefreshToken {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  userId String
  user   PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  // Set when this token was rotated forward on refresh — lets a stolen,
  // already-rotated token be traced even after it stops working.
  replacedByTokenHash String?

  createdAt DateTime @default(now())

  @@index([userId])
}

// =============================================================================
// PASSWORD RESET TOKENS
// =============================================================================
// Same opaque-token-plus-hash pattern as RefreshToken, for the Forgot
// Password → Reset Password flow. Short-lived (see env.PASSWORD_RESET_TOKEN_
// EXPIRY_MINUTES) and single-use (usedAt).
model PasswordResetToken {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  userId String
  user   PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
}

// =============================================================================
// AUTH AUDIT LOG
// =============================================================================
// Auth-scoped security events only (login/logout/password/lock/refresh) —
// NOT the full cross-module activity log the frontend's Settings > Audit
// screens model (that spans every module and is its own future module).
// userId is nullable because a failed login against an email that doesn't
// exist has no user to attach to, but is still worth recording.
model AuthAuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  userId String?
  user   PortalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  email     String
  event     String
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
}

// =============================================================================
// MODULE ACCESS (Dashboard, Projects, Customer Master, Timesheets, Invoices,
// Reports, Manpower, Documents, Settings, Notifications, Reminders)
// =============================================================================
// A lookup TABLE, not a Prisma/TS enum — new modules can be added later with
// a plain INSERT, no code deployment. A row in UserModuleAccess = that user
// currently has access to that module; absence = no access. No view/edit/
// delete sub-levels — the frontend's "Module Permissions" step is a flat
// per-module grant, so the schema doesn't invent finer-grained levels it
// was never asked for.
model Module {
  id          String  @id @default(dbgenerated("gen_random_uuid()"))
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  userAccess UserModuleAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserModuleAccess {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  userId String
  user   PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, moduleId])
}

// =============================================================================
// REGION ACCESS (India, Qatar, Malaysia, Oman, Abu Dhabi, FZI, Elixir Qatar)
// =============================================================================
// Same lookup-table + join-table pattern as Module Access, for the same
// reason: which regions exist is data, not code.
model Region {
  id       String  @id @default(dbgenerated("gen_random_uuid()"))
  name     String  @unique
  isActive Boolean @default(true)

  userAccess UserRegionAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserRegionAccess {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  userId String
  user   PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  regionId String
  region   Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, regionId])
}

// =============================================================================
// APPROVAL PERMISSIONS (Approve Timesheets, Approve Expenses, Approve
// Invoices, Approve Customers, Approve Budget Changes, Approve Project
// Creation, Approve Reminders, Archive Projects)
// =============================================================================
// Same lookup-table + join-table pattern again, for consistency — approval
// rights are just as much "per-user data" as module/region access, so they
// follow the identical shape rather than becoming a one-off set of boolean
// columns on PortalUser.
model ApprovalType {
  id          String  @id @default(dbgenerated("gen_random_uuid()"))
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  userGrants UserApprovalPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserApprovalPermission {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  userId String
  user   PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  approvalTypeId String
  approvalType   ApprovalType @relation(fields: [approvalTypeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, approvalTypeId])
}

// =============================================================================
// PROJECT — Phase 3.1 Foundation (General Information ONLY)
// =============================================================================
// Mirrors frontend/src/types/Project.ts's General Information fields exactly
// — the field set actually shown/edited by GeneralInfoCard.tsx and
// GeneralView.tsx, the frontend's source of truth for this phase. Quantity,
// GST/Commercial, Payment Milestones, Invoice, Expense, Team, Expense
// Budget, Documents, Notes, and Reminders all belong to later phases and are
// deliberately NOT modeled here yet — the mature frontend for those still
// runs entirely on localStorage until each is built out in turn.
//
// prCategory doubles as "Region" for filtering purposes — its values (India,
// Malaysia, Oman, Abu Dhabi, FZI, Elixir Qatar, Qatar) are the exact same set
// already seeded into the Region lookup table for Auth's module/region
// access grants. There is no separate region field to invent.
//
// Soft delete only: isDeleted/deletedAt. No hard delete anywhere — every
// list/detail read must filter isDeleted: false.
model Project {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  poMonth         String
  prCategory      String
  prNo            String
  client          String
  department      String
  domesticForeign String
  projectTitle    String

  workOrderStatus  String
  projectStartDate DateTime
  projectEndDate   DateTime?
  projectStatus    String

  // Formal Project Completion fields
  actualCompletionDate DateTime?
  completionRemarks    String?
  completedBy          String?
  completedTimestamp   DateTime?

  // Work Order Details
  workOrderNumber String?
  workOrderDate   DateTime?
  eicName         String?
  contactNumber   String?
  emailId         String?

  // Project Scheduling
  estimatedDuration Int?
  durationUnit      String?

  // Additional Information
  contractType   String  @default("LUMP SUM")
  pmoCoordinator String?

  // Payment Milestones — "Single" forces exactly one milestone at 100% on
  // the frontend; "Multiple" allows 1+ milestones. Lives on Project (not
  // PaymentMilestone) because it is a project-wide toggle, not per-row data
  // — see docs/PMO_PORTAL_TECHNICAL_DOCUMENTATION.md's Payment Milestone
  // architectural analysis.
  paymentType String @default("Single")

  // Expense Budget — Phase 3.5. Deliberately flat on Project, NOT a child
  // table: this is a 1:1 attribute (exactly one Man-Hour Budget and one
  // Non-Man-Hour Budget per project, always), same treatment as every other
  // General Information scalar field above. Do not confuse with
  // ProjectExpense below, which IS a real child collection — two
  // independent modules that happen to ship in the same phase.
  manhourBudgetAmount     Float?
  manhourBudgetHours      Float?
  manhourBudgetRemarks    String?
  nonManhourBudgetAmount  Float?
  nonManhourBudgetRemarks String?

  // Project Leadership — Phase 3.7. Flat on Project (not a child table):
  // exactly one leadership team per project, same 1:1-attribute treatment
  // as Expense Budget above. pmoCoordinator already existed (Phase 3.1) —
  // not repeated here. All nullable/optional: a brand-new project's General
  // Information create request has no reason to already know its
  // leadership team, matching every other additive field set's precedent.
  primaryProjectManager   String?
  secondaryProjectManager String?
  projectEngineer         String?
  projectCoordinator      String?
  clientCoordinator       String?

  // Quantity Information
  quantityItems QuantityItem[]

  // Payment Milestone Information
  paymentMilestones PaymentMilestone[]

  // Other Project Expenses — Phase 3.5. The actual expense ledger
  // (Add/Edit/Delete rows) — a genuine 1:many child collection, same shape
  // as QuantityItem/PaymentMilestone above. See the Expense Budget note
  // above for why this is modeled differently.
  projectExpenses ProjectExpense[]

  // Team Assigned — Phase 3.7. Read-only, Timesheet-import-derived child
  // collection (see ProjectResource below) — Project itself never writes to
  // it; nothing in this phase does either. Included on the relation side
  // only so onDelete: Cascade (declared on ProjectResource) has something
  // to cascade from.
  projectResources ProjectResource[]

  // Timesheet raw rows — Phase 3.8. onDelete: SetNull is declared on
  // TimesheetEntry.project, not here — included on this side only so that
  // behavior has something to relate from. See TimesheetEntry's own comment
  // for why this is SetNull (not Cascade): a permanently-deleted project
  // must not erase the historical fact that someone logged hours against
  // it, unlike ProjectResource above, which legitimately has nothing left
  // to aggregate once its Project is gone.
  timesheetEntries TimesheetEntry[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDeleted])
  @@index([projectStatus])
  @@index([department])
  @@index([client])
  @@index([prCategory])
}

model QuantityItem {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  description String

  woQty      Float
  invoiceQty Float
  pendingQty Float

  uom        String  @default("")
  assignedTo String?
  currency   String  @default("INR")

  unitRate     Float
  exchangeRate Float
  unitRateINR  Float

  woValue       Float
  pendingAmount Float

  invoiceLines InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// =============================================================================
// PAYMENT MILESTONE — approved via docs/PMO_PORTAL_TECHNICAL_DOCUMENTATION.md's
// "Payment Milestone ID Stability Strategy" design.
// =============================================================================
// `amount` is deliberately NOT a column here — same reasoning as
// QuantityItem's derived fields: it is 100% computable from
// paymentPercentage and the parent project's Work Order Value (the sum of
// QuantityItem.woValue for that project) at read time, and storing it would
// let it silently drift from Quantity the moment any Quantity row changes
// after a milestone was saved. See milestone.service.ts's computeAmount().
//
// `id` stays @default(dbgenerated(...)) exactly like every other model —
// the approved design's Ingest path explicitly supplies its own id value in
// the data passed to Prisma (honored over the default), rather than
// requiring any schema-level exception here.
model PaymentMilestone {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  milestoneName     String
  paymentPercentage Float
  dueDate           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// =============================================================================
// INVOICE LINE — Invoice Backend Phase. No separate "InvoiceItem" table
// exists: the frontend's InvoiceItem shape (id/description/qty/uom/
// unitPrice/totalPrice/invoices[]) is 100% derived from a QuantityItem plus
// its InvoiceLine rows, computed at read time by invoice.service.ts. This
// makes `InvoiceItem.id === QuantityItem.id` true by construction, exactly
// matching what frontend/src/services/invoiceSyncService.ts's
// syncInvoiceItemsWithQuantity() already assumes today (it keys every
// InvoiceItem off `quantityItem.id`).
//
// quantityItemId is a real FK with onDelete: Restrict (not Cascade) — a
// QuantityItem with non-Cancelled invoice history must not be deletable at
// all, let alone silently take that history down with it. Enforced twice:
// here at the DB level as the final backstop, and in quantity.service.ts's
// deleteQuantityItem() as the actual user-facing 409 guard (see
// invoice.repository.ts's countNonCancelledLinesForQuantityItem()).
//
// unitPriceINR/calculatedAmountINR/commercialAdjustmentINR are real, stored
// columns (unlike PaymentMilestone.amount) because they are historical
// snapshots, not always-current derived values: unitPriceINR is the
// QuantityItem's rate AT THE TIME this line was raised, and
// calculatedAmountINR/commercialAdjustmentINR are computed from it then —
// recomputing them later from a QuantityItem's CURRENT unitRateINR would
// silently rewrite invoice history every time a rate changes. See
// invoice.service.ts for exactly when each is computed vs. preserved
// verbatim (ordinary create vs. legacy-migration ingest).
//
// milestoneId/milestoneName are plain, unenforced strings (no FK to
// PaymentMilestone) — same treatment as every other cross-reference in this
// schema that must survive its target's own lifecycle (TimesheetEntry.
// employeeNo, ProjectResource.employeeNo): a milestone can be renamed or
// removed without corrupting already-raised invoice history.
//
// status is a plain string with a default, matching every other status-like
// field in this schema (Employee.status, TimesheetImport.status) rather
// than a Prisma enum — see frontend/src/types/InvoiceItem.ts's
// InvoiceLineStatus for the 5 values actually in use
// (Draft/Raised/PartiallyPaid/Paid/Cancelled).
//
// `id` stays @default(dbgenerated(...)) exactly like every other model —
// the legacy-migration Ingest path (mirroring Payment Milestones' own
// Ingest) explicitly supplies its own id value, honored by Prisma over the
// default, because notifications/notificationTypes.ts's invoiceLineId deep-
// link field may already reference a pre-migration id from an
// already-dispatched local notification.
// =============================================================================
model InvoiceLine {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  quantityItemId String
  quantityItem   QuantityItem @relation(fields: [quantityItemId], references: [id], onDelete: Restrict)

  invoiceNo   String
  invoiceDate DateTime

  milestoneId   String?
  milestoneName String?
  setIndex      Int?

  description String?

  quantityBilled Float

  unitPriceINR            Float?
  calculatedAmountINR     Float?
  invoiceAmountINR        Float
  commercialAdjustmentINR Float?

  clientReference String?
  remarks         String?

  status    String @default("Draft")
  createdBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quantityItemId])
  @@index([invoiceNo])
}

// =============================================================================
// PROJECT EXPENSE — "Other Project Expenses," Phase 3.5. A real child
// collection (Add/Edit/Delete rows), independent of the flat Expense Budget
// fields on Project above — same shape as QuantityItem/PaymentMilestone.
// =============================================================================
// `totalCost` mirrors QuantityItem's `woValue`/`unitRateINR`: derived
// server-side (quantity * unitCost) and stored as a real column rather than
// trusted from client input, per project.repository.ts's own convention. See
// expense.service.ts's computeTotalCost().
model ProjectExpense {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  category    String
  description String
  quantity    Float
  unitCost    Float
  totalCost   Float
  remarks     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// =============================================================================
// EMPLOYEE — "Employee Master" / Manpower, Phase 3.7. The single source of
// employee information across the whole Portal. `employeeNo` is the natural,
// human-assigned business key every other module already references by
// (TimesheetEntry, the pre-existing frontend ProjectResource type) — kept as
// the primary matching key here too, not replaced by the surrogate `id`.
// =============================================================================
model Employee {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  employeeNo       String  @unique
  employeeName     String
  department       String
  designation      String
  reportingManager String?
  grade            String
  location         String

  // "Current Hourly Rate" in business terms — kept under the frontend's own
  // existing field name (see EmployeeModal.tsx / Excel import template) so
  // this migration doesn't invent a second name for the same thing.
  manhourExpenses Float @default(0)

  status String @default("Active")

  dateOfJoining DateTime?
  employeeType  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([status])
}

// =============================================================================
// PROJECT RESOURCE — "Team Assigned," Phase 3.7. Represents Employee ↔
// Project assignment ONLY — never a second Employee Master. Name/department/
// designation/grade/reportingManager/location are always read live from
// Employee above, never duplicated onto this table.
// =============================================================================
// `employeeNo` is a plain column, not a Prisma relation to Employee: this is
// deliberate, not an oversight — `hourlyRateSnapshot` exists specifically so
// a row's historical cost survives independently of whatever Employee Master
// says later (including if that Employee row is ever deleted). Referential
// sanity on create/update is enforced in the service layer instead (a row's
// employeeNo must currently exist in Employee), matching the same
// "application-level guard, no DB-level FK" approach already used for
// Delete Permanently's Invoice Protection check.
//
// This module is backend-only as of Phase 3.7 — no frontend code calls it
// yet. Team Assigned's live UI (ExpandableTeamMembersCard.tsx) continues to
// compute everything from raw Timesheet data, exactly as it does today; a
// future Timesheet backend phase will become the only process that ever
// creates or updates rows here, via the API shape already built now.
model ProjectResource {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  employeeNo String

  assignmentStartDate DateTime?
  assignmentEndDate   DateTime?
  assignmentStatus    String    @default("Active")

  // Frozen at row creation/update time from Employee.manhourExpenses —
  // never re-derived from a later Employee read. See the model-level
  // comment above for why this must never change historical cost.
  hourlyRateSnapshot Float

  workingDays Float @default(0)
  totalHours  Float @default(0)

  // Server-derived: totalHours * hourlyRateSnapshot. Never accepted from a
  // client — same "never trust a client-computed derived value" convention
  // as QuantityItem.woValue/unitRateINR and ProjectExpense.totalCost.
  manhourCost Float @default(0)

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per Employee + Project — an assignment sync is an upsert on
  // this key, matching the brief's "one employee, multiple projects, each
  // its own record" rule exactly.
  @@unique([projectId, employeeNo])
  @@index([projectId])
  @@index([employeeNo])
}

// =============================================================================
// TIMESHEET ENTRY — Phase 3.8. The reconciled, current-state record for one
// (employeeNo, projectId, workDate, task) combination, sourced from KEKA
// Timesheet data (Microsoft Graph email ingestion or an Administrator's
// manual upload — both go through the exact same processTimesheetImport()
// engine, see timesheet.service.ts). This is the actual source of truth
// ProjectResource is recomputed from; it is never itself derived from
// ProjectResource.
// =============================================================================
// Row identity (employeeNo + projectId + workDate + task) is DELIBERATELY
// NOT a database UNIQUE constraint yet — see @@index below. The real KEKA
// Excel format has not been verified as of this phase (Stage 1-4 analysis),
// and Task's reliability as a differentiator is provisional evidence from a
// synthetic test fixture, not a confirmed real-world fact. Reconciliation
// (find-existing-or-create) is therefore enforced in timesheet.service.ts at
// the application level, which stays cheap to revise if a real file proves
// Task should be dropped from the identity — a DB-level constraint would
// not.
//
// employeeNo is a plain string, no FK — same precedent as
// ProjectResource.employeeNo (Phase 3.7): historical timesheet data must
// survive independently of Employee Master's lifecycle. This is not a gap
// in practice — employees/employee.service.ts's deleteEmployee() already
// refuses to delete an Employee referenced by any ProjectResource, and a
// ProjectResource always exists for the same (employeeNo, projectId) pair
// wherever a TimesheetEntry does (see projectResource.service.ts), so this
// loop is already closed by existing, unmodified Phase 3.7 code.
//
// projectId IS a real, nullable FK, with onDelete: SetNull — deliberately
// different from ProjectResource's onDelete: Cascade above. If a Project
// this row currently points to is ever permanently deleted (Phase 3.6),
// Postgres nulls this FK out automatically; rawProjectCode (plain text,
// never touched by that cascade) keeps the historical fact readable even
// though there is no longer a live Project to relate to. Team Assigned/
// ProjectResource correctly show nothing for a permanently-deleted
// project's assignments (there is no ProjectResource left to read, since
// that table WAS cascade-deleted) — this table alone preserves the raw
// historical record for audit purposes.
model TimesheetEntry {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  employeeNo String

  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  rawProjectCode String

  workDate DateTime

  // Normalized to "" when the source Excel row has no Task column/value —
  // never left null, so identity comparisons in application code never hit
  // Postgres's "NULL is distinct from every other NULL" surprise.
  task String @default("")

  hours Float

  // KEKA's own optional per-row lifecycle marker ("Active"/"Released").
  // Deliberately independent of ProjectResource.assignmentStatus, which is
  // never inferred purely from hours reaching zero (see
  // projectResource.service.ts) — this is the raw signal that feeds it.
  sourceStatus String @default("Active")

  // Which import first created this exact row, and which one most recently
  // changed it — enough to answer "which import changed this record"
  // (Phase 3.8's audit requirement) without always joining through
  // TimesheetImportRowLog. Full change-by-change history still lives there.
  firstImportId String
  firstImport   TimesheetImport @relation("TimesheetEntryFirstImport", fields: [firstImportId], references: [id])
  lastImportId  String
  lastImport    TimesheetImport @relation("TimesheetEntryLastImport", fields: [lastImportId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rowLogs TimesheetImportRowLog[]

  // Non-unique — see the model-level comment above for why reconciliation
  // is application-level, not enforced here.
  @@index([employeeNo, projectId, workDate, task])
  @@index([projectId])
  @@index([employeeNo])
}

// =============================================================================
// TIMESHEET IMPORT — Phase 3.8. One row per processed KEKA email attachment
// OR Administrator manual upload (see triggeredBy) — the permanent audit
// header record. Never deleted.
// =============================================================================
model TimesheetImport {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  // Null for a manual upload. Unique when present — this IS the duplicate
  // email guard (a different concern from row-level reconciliation above:
  // this answers "have we already processed this exact email," row identity
  // answers "has this specific timesheet fact changed").
  emailMessageId     String? @unique
  attachmentId       String?
  attachmentFilename String?

  receivedAt           DateTime? // from the source email's metadata; null for a manual upload
  processingStartedAt  DateTime?
  processingFinishedAt DateTime?

  // Pending | Processing | Succeeded | PartiallySucceeded | Failed — a plain
  // string with a default, matching every other status-like field already
  // in this schema (Employee.status, ProjectResource.assignmentStatus), not
  // a Prisma enum.
  status String @default("Pending")

  totalRows      Int @default(0)
  createdCount   Int @default(0)
  updatedCount   Int @default(0)
  unchangedCount Int @default(0)
  removedCount   Int @default(0)
  failedCount    Int @default(0)

  errorSummary String?

  // EmailPoll | ManualUpload — the only thing that ever differs between the
  // two callers of processTimesheetImport(); see timesheet.service.ts.
  triggeredBy String

  // Set only for a ManualUpload — the acting PortalUser.id. No relation
  // declared (this module doesn't need to join back to PortalUser for
  // anything) — same "plain reference, not a hard FK" treatment already
  // used for employeeNo above and ProjectResource.employeeNo in Phase 3.7.
  uploadedByUserId String?

  rowLogs                 TimesheetImportRowLog[]
  entriesFirstCreated     TimesheetEntry[]        @relation("TimesheetEntryFirstImport")
  entriesLastTouched      TimesheetEntry[]        @relation("TimesheetEntryLastImport")

  createdAt DateTime @default(now())

  @@index([receivedAt])
  @@index([status])
}

// =============================================================================
// TIMESHEET IMPORT ROW LOG — Phase 3.8. Append-only, one row per (Excel row,
// import) outcome. Never updated after creation — this is what makes
// "which KEKA email changed this employee's hours from 4 to 6" a real,
// traceable database query rather than a reconstruction exercise.
// =============================================================================
model TimesheetImportRowLog {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  importId String
  import   TimesheetImport @relation(fields: [importId], references: [id])

  // Nullable + SetNull deliberately: if the referenced TimesheetEntry is
  // later removed (a zero-hour correction, see the Removed outcome below),
  // this historical log row must survive regardless — the raw values below
  // (rawEmployeeNo/rawProjectCode/workDate/task/previousHours/newHours)
  // always carry the full historical fact independent of the live entry's
  // fate.
  entryId String?
  entry   TimesheetEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  rawEmployeeNo  String
  rawProjectCode String
  workDate       DateTime
  task           String

  previousHours Float?
  newHours      Float?

  // Created | Updated | Unchanged | Removed | Failed
  outcome       String
  failureReason String?

  createdAt DateTime @default(now())

  @@index([importId])
  @@index([entryId])
}

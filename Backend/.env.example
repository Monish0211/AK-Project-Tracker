# Prisma reads this via prisma.config.ts (import "dotenv/config"), not automatically.
DATABASE_URL="postgresql://user:password@localhost:5432/ifluids_pmov1"

NODE_ENV=development
PORT=5000

# Minimum 32 characters. Generate a real secret per environment — never reuse across dev/staging/prod.
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN=8h

BCRYPT_SALT_ROUNDS=12

REFRESH_TOKEN_EXPIRES_IN_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
PASSWORD_EXPIRY_DAYS=90
MAX_FAILED_LOGIN_ATTEMPTS=5

# Used only by prisma/seed.ts to create the first Administrator login.
ADMIN_BOOTSTRAP_EMAIL=admin@ifluids.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe@123

# Email (Nodemailer) — all optional; the app boots fine with these blank,
# it just logs that email sending is disabled until they're filled in.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="iFluids Engineering PMO Portal"
SMTP_FROM_EMAIL=noreply@example.com

# Used to build links inside emails (e.g. "Log in" / "Reset your password").
FRONTEND_URL=http://localhost:5173

# Prisma reads this via prisma.config.ts (import "dotenv/config"), not automatically.
DATABASE_URL="postgresql://user:password@localhost:5432/ifluids_pmov1"

NODE_ENV=development
PORT=5000

# Minimum 32 characters. Generate a real secret per environment — never reuse across dev/staging/prod.
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN=8h

BCRYPT_SALT_ROUNDS=12

REFRESH_TOKEN_EXPIRES_IN_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
PASSWORD_EXPIRY_DAYS=90
MAX_FAILED_LOGIN_ATTEMPTS=5

# Used only by prisma/seed.ts to create the first Administrator login.
ADMIN_BOOTSTRAP_EMAIL=admin@ifluids.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe@123

# Email (Nodemailer) — all optional; the app boots fine with these blank,
# it just logs that email sending is disabled until they're filled in.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="iFluids Engineering PMO Portal"
SMTP_FROM_EMAIL=noreply@example.com

# Used to build links inside emails (e.g. "Log in" / "Reset your password").
FRONTEND_URL=http://localhost:5173

# Microsoft Graph / KEKA Timesheet email ingestion — Phase 3.8. All
# optional; the app boots fine with these blank, it just logs that mailbox
# polling is disabled until every one of them is filled in (same treatment
# as SMTP above). Application permission (Mail.Read), never Delegated —
# this must work with nobody logged in. Never commit real values here.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
KEKA_MAILBOX=
KEKA_SENDER_EMAIL=no-reply@kekamail.com
# Not yet confirmed with KEKA/HR — matched as a case-insensitive substring
# against the real subject line once known (see mailPoll.service.ts). Leave
# blank to match on sender alone until this is confirmed.
KEKA_SUBJECT_PATTERN=
KEKA_ATTACHMENT_NAME=Employee Time Entry Details
KEKA_POLL_LOOKBACK_DAYS=7

# Shared secret protecting POST /internal/timesheets/poll — this is hit by
# a scheduler/cron process with no logged-in user, never by the frontend.
# Generate a real random value per environment, same rule as JWT_SECRET.
INTERNAL_POLL_SECRET=

# Anthropic Claude — PDF Import AI-assist supplement. Optional; the app
# boots fine with this blank, the pdfImport module simply refuses to run
# (503) until it's set. Backend-only — never expose this to the frontend,
# never prefix it VITE_, never commit a real value here. Changing this in
# .env requires a backend restart to take effect (no hot-reload).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_REQUEST_TIMEOUT_MS=60000
PDF_IMPORT_AI_MAX_FILE_SIZE_MB=20
# Multi-document cross-verification — bounds ONE Claude request containing
# every uploaded PDF in a document set, independent of the per-file cap
# above. See env.ts's own comment for why these exist separately.
PDF_IMPORT_AI_MAX_DOCUMENT_SET_MB=20
PDF_IMPORT_AI_MAX_DOCUMENTS_PER_SET=10

# Optional, opt-in CORS restriction. Leave BLANK to keep today's behavior
# (every origin allowed) unchanged. Set this ONLY once you have confirmed
# the real production frontend URL (e.g. the GitHub Pages URL this repo
# deploys to) — setting this to the wrong value will lock the real
# frontend out of the entire API, not just PDF Import.
CORS_ALLOWED_ORIGIN=
